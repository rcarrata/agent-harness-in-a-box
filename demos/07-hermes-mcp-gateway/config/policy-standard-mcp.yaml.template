# Standard sandbox policy for Hermes agent with MCP Gateway.
# Allows inference (LiteLLM + OpenRouter), PyPI (skill installs), GitHub (read-only),
# NousResearch (model catalog), Mattermost, RHOAI MLflow tracing, web search,
# MCP Gateway, Keycloak (MCP realm), and Gitea.
# Blocks GitHub write operations and arbitrary web access.
#
# Template: replace __OCP_APPS_DOMAIN__ before applying.
# Apply:  openshell policy set [--wait] <sandbox-name> --policy <rendered-file>
# Test:   bash test-sandbox-security.sh <sandbox-name>

version: 1

filesystem_policy:
  include_workdir: true
  read_only:
    - /usr
    - /lib
    - /lib64
    - /bin
    - /sbin
    - /proc
    - /dev/urandom
    - /etc
    - /app
    - /opt
    - /var/log
  read_write:
    - /sandbox
    - /workspace
    - /tmp
    - /home/sandbox
    - /dev/null
    - /dev/zero

landlock:
  compatibility: best_effort

process:
  run_as_user: sandbox
  run_as_group: sandbox

network_policies:

  litellm_maas:
    name: "LiteLLM MaaS"
    endpoints:
      - host: "maas-rhdp.apps.maas.redhatworkshops.io"
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
      - host: "*.redhatworkshops.io"
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/python3.12 }
      - { path: "/usr/local/bin/hermes" }
      - { path: "/sandbox/.uv/python/**" }

  openrouter:
    name: "OpenRouter"
    endpoints:
      - host: openrouter.ai
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/python3.12 }
      - { path: "/usr/local/bin/hermes" }

  pypi:
    name: "PyPI"
    endpoints:
      - host: pypi.org
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
      - host: files.pythonhosted.org
        port: 443
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/python3.12 }
      - { path: "/sandbox/.uv/python/**" }

  github_readonly:
    name: "GitHub (read-only)"
    endpoints:
      - host: github.com
        port: 443
        protocol: rest
        enforcement: enforce
        access: read-only
      - host: api.github.com
        port: 443
        protocol: rest
        enforcement: enforce
        access: read-only
      - host: "*.githubusercontent.com"
        port: 443
        enforcement: enforce
        access: read-only
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/git }
      - { path: /usr/bin/python3 }

  nousresearch:
    name: "NousResearch (model catalog)"
    endpoints:
      - host: hermes-agent.nousresearch.com
        port: 443
        protocol: rest
        enforcement: enforce
        access: read-only
      - host: nousresearch.com
        port: 443
        protocol: rest
        enforcement: enforce
        access: read-only
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }
      - { path: "/usr/local/bin/hermes" }

  openshift_oauth:
    name: "OpenShift OAuth (for RHOAI auth)"
    endpoints:
      - host: "oauth-openshift.__OCP_APPS_DOMAIN__"
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/curl }

  mattermost:
    name: "Mattermost"
    endpoints:
      - host: "mattermost-mattermost.__OCP_APPS_DOMAIN__"
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/python3.12 }
      - { path: "/usr/local/bin/hermes" }

  mlflow_rhoai:
    name: "RHOAI MLflow"
    endpoints:
      - host: "mlflow.redhat-ods-applications.svc.cluster.local"
        port: 8443
        protocol: rest
        enforcement: enforce
        access: full
      - host: "mlflow-redhat-ods-applications.__OCP_APPS_DOMAIN__"
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/python3.12 }
      - { path: "/sandbox/.uv/python/**" }

  web_search:
    name: "Web Search"
    endpoints:
      - host: duckduckgo.com
        port: 443
        protocol: rest
        enforcement: enforce
        access: read-only
      - host: links.duckduckgo.com
        port: 443
        enforcement: enforce
        access: read-only
      - host: html.duckduckgo.com
        port: 443
        enforcement: enforce
        access: read-only
      - host: search.brave.com
        port: 443
        enforcement: enforce
        access: read-only
      - host: "*.brave.com"
        port: 443
        enforcement: enforce
        access: read-only
      - host: www.startpage.com
        port: 443
        enforcement: enforce
        access: read-only
      - host: www.bing.com
        port: 443
        enforcement: enforce
        access: read-only
    binaries:
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/python3.12 }
      - { path: "/usr/local/bin/hermes" }

  mcp_gateway:
    name: "MCP Gateway"
    endpoints:
      - host: "mcp.__OCP_APPS_DOMAIN__"
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/python3.12 }
      - { path: "/usr/local/bin/hermes" }

  keycloak_mcp:
    name: "Keycloak (MCP realm)"
    endpoints:
      - host: "keycloak-mcp-test.__OCP_APPS_DOMAIN__"
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }

  gitea:
    name: "Gitea"
    endpoints:
      - host: "gitea-gitea.__OCP_APPS_DOMAIN__"
        port: 443
        protocol: rest
        enforcement: enforce
        access: full
    binaries:
      - { path: /usr/bin/git }
      - { path: /usr/bin/curl }
      - { path: /usr/bin/python3 }
